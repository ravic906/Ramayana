[gd_resource type="Resource" script_class="DialogueResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "|grove_wide|wait:0.6|
Tataka|tataka||Princes of men, in my forest? I will grind your bones to dust as I did the others.|fury
Rama|close||Guru-dev, she is a woman. Is there no other way?|concern
Vishvamitra|close||Ask instead: how many have no other way while she lives? A protector's duty does not look away.|resolve
Vishvamitra|close||Kings before you have stopped those who destroy the innocent, whoever they were. That is not cruelty, Rama. It is care for the many.|calm
Rama|close||Then I will try to turn her back first. If she will not turn, I will not look away.|resolve"
