[gd_resource type="Resource" script_class="DialogueResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "Narration|||Golden Ayodhya, on the banks of the Sarayu. The princes trained beneath their guru's eye...
Vasishtha|vasishtha||Again, Rama. Not faster. Truer.|calm
Rama|close||The bow pulls when I breathe, Guru-dev.|concern
Vasishtha|close||Then do not fight your breath. Let the arrow leave between one breath and the next.|calm
Vasishtha|vasishtha||An arrow obeys the hand. The hand must obey something higher.|resolve
Rama|close||The heart, Guru-dev?|wonder
Vasishtha|close||Dharma. The heart can be mistaken.|calm
Lakshmana|brothers||Brother, leave one for me. Just one.|smile
Rama|close||Watch my left, then, and I will leave you the last.|smile
Vasishtha|vasishtha||Then let us see what you have learned. These are only shadows of my making. Face them as if they were not.|resolve"
