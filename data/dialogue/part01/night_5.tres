[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "Narration|||On the fifth night, the whole forest seemed to march on the ashram.
Lakshmana|brothers||Brother... that one is the size of a tree.
Rama|rama||Size is not strength, brother. Stand with me."
