[gd_resource type="Resource" script_class="DialogueResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "|camp_wide||
Narration|camp_wide||They walked until the sun lay low over the Sarayu, and there, on the southern bank, the sage stopped.
Vishvamitra|close||Rama. Go down to the water. Sip it, and wash your hands and face. What I give now must be received clean.|calm
|water|rama_sip|
Rama|water||It is done, Guru-dev.|reverence
Vishvamitra|close||These are Bala and Atibala, born of Brahma himself. Hold them in mind, and you will know no hunger, no thirst, no weariness.|reverence
Vishvamitra|close||While you keep them, no one in the three worlds will be your equal, not in strength, not in wisdom, not in answer.|reverence
|camp_wide|grant_bala|
Rama|close||I receive them as I would receive water in the desert, Guru-dev. With thanks, and with care.|reverence
Lakshmana|close||Brother, it is strange. We walked from noon, and I am not tired at all.|wonder
Vishvamitra|close||That is the first of their gifts. Not the last.|smile
Rama|close||Guru-dev, why do you give this to us, here, on a riverbank?|wonder
Vishvamitra|close||Because a teaching should be given where it will be needed. The forest ahead has no rivers that sing.|concern
Vishvamitra|close||Sleep now. The grass is soft, and the night will keep watch with me.|calm
|camp_wide|nightfall|
Narration|camp_wide||The princes slept on beds of grass beside the river, and the sage sat awake under the stars."
