[gd_resource type="Resource" script_class="DialogueResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "Narration|||They walked into lands where no bird sang: the lands of Malada and Karusha.
Vishvamitra|sage||No bird sings here. Listen to what silence costs a land.
Vishvamitra|sage||Tataka rules this forest. Once a yakshini of great strength, she became a terror after a sage's curse. Her son Maricha follows her.
Lakshmana|brothers||Stay close, brother. The trees themselves are watching."
