[gd_resource type="Resource" script_class="DialogueResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "Narration|||On the fourth night, the rakshasas came for the sages themselves.
Vishvamitra|altar||The sages must not move, whatever comes. Their lives are in your hands now."
