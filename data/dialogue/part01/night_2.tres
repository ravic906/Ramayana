[ext_resource type="Script" path="res://core/story/dialogue_resource.gd" id="1_d"]

[resource]
script = ExtResource("1_d")
text = "Narration|||On the second night, a fog of maya rose from the forest.
Vishvamitra|altar||Illusions, Rama. Of every shape you see, only one is true. Look for the one that shimmers."
