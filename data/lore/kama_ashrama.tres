[gd_resource type="Resource" script_class="LoreResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/quests/lore_resource.gd" id="1_l"]

[resource]
script = ExtResource("1_l")
id = &"kama_ashrama"
title = "The Hermitage of Kama"
text = "Near the confluence stood an ashram where Shiva once sat in tapas. When Kama, the god of love, tried to disturb his meditation, Shiva's third eye burned him to ash, and the land took the name Anga, the bodiless. The sages there welcomed the princes for a night."
