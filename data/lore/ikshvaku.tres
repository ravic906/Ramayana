[gd_resource type="Resource" script_class="LoreResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/quests/lore_resource.gd" id="1_l"]

[resource]
script = ExtResource("1_l")
id = &"ikshvaku"
title = "The Line of Ikshvaku"
text = "Rama is born in the solar dynasty of Ikshvaku, descended from Surya through Manu. Kings of this line, Raghu among them, were remembered for keeping their word; Rama is often called Raghava, 'of Raghu's line'."
