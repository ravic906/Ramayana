[gd_resource type="Resource" script_class="LoreResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/quests/lore_resource.gd" id="1_l"]

[resource]
script = ExtResource("1_l")
canon = "Griffith V-VI"
id = &"ayodhya"
title = "Ayodhya"
text = "The name Ayodhya means 'the unconquerable', a city that cannot be fought. Valmiki describes it on the bank of the Sarayu in the land of Kosala: twelve leagues long and three wide, with gates at even distances, a glorious royal road sprinkled and strewn with flowers, belted round with sal trees, and laid out like a chessboard. Its people were truthful and content, and no one in it was poor."
