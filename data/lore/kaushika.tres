[gd_resource type="Resource" script_class="LoreResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/quests/lore_resource.gd" id="1_l"]

[resource]
script = ExtResource("1_l")
id = &"kaushika"
title = "Kaushika, the King Who Became a Sage"
text = "Before he was Vishvamitra, he was King Kaushika, a mighty ruler. Turned back by the power of Vasishtha's austerity, he set aside his crown and undertook tapas of his own for thousands of years, until even Vasishtha named him a brahmarshi. The friend of all the world: that is what his name means."
