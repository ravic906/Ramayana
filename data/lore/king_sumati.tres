[gd_resource type="Resource" script_class="LoreResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/quests/lore_resource.gd" id="1_l"]

[resource]
script = ExtResource("1_l")
id = &"king_sumati"
title = "King Sumati"
text = "Hearing that Vishvamitra had come, King Sumati went out with his priests to honour him, and asked at once who the two young men with him were, who walked like lions and seemed fit to be gods. Learning they were Dasharatha's sons, he received them as kin."
