extends Node
## Spoken lines. Audio for "Speaker|text" lives at
## assets/audio/voice/<md5("Speaker|text")>.ogg, generated by tools/gen_voices.py,
## so any line shown as a subtitle can be spoken without extra data.
## While a line plays, the music dips (Music.voice_duck).

signal line_finished

const DIR := "res://assets/audio/voice/"

var speaking := false
## Who is speaking now (the "Speaker" part of the line), for lip sync.
var current_speaker := ""
var _player: AudioStreamPlayer
var _lipsync := {}
var _envelope := ""
const LIPSYNC_FPS := 30.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	Settings.ensure_audio_buses()
	_player = AudioStreamPlayer.new()
	_player.name = "VoicePlayer"
	_player.bus = &"Voice"
	_player.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_player)
	_player.finished.connect(_on_finished)
	var data = JSON.parse_string(FileAccess.get_file_as_string(DIR + "lipsync.json"))
	if data is Dictionary:
		_lipsync = data


static func key(speaker: String, text: String) -> String:
	return ("%s|%s" % [speaker, text]).md5_text()


static func path_for(speaker: String, text: String) -> String:
	return DIR + key(speaker, text) + ".ogg"


func has_line(speaker: String, text: String) -> bool:
	return ResourceLoader.exists(path_for(speaker, text))


## Speaks a line and returns its length in seconds (0 if there is no audio, or
## if `interrupt` is false and someone is already speaking).
func say(speaker: String, text: String, interrupt := true) -> float:
	if speaking and not interrupt:
		return 0.0
	if not has_line(speaker, text):
		return 0.0
	var stream := load(path_for(speaker, text)) as AudioStream
	if stream == null:
		return 0.0
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = false
	_player.stream = stream
	_player.play()
	speaking = true
	current_speaker = speaker
	_envelope = _lipsync.get(key(speaker, text), "")
	Music.voice_duck(true)
	return stream.get_length()


func stop() -> void:
	if speaking:
		_player.stop()
		_on_finished()


## How open the speaker's mouth should be right now (0..1), from the line's
## precomputed loudness envelope (tools/gen_voices.py writes lipsync.json).
func mouth_level() -> float:
	if not speaking or _envelope.is_empty():
		return 0.0
	var i := int(_player.get_playback_position() * LIPSYNC_FPS)
	if i < 0 or i >= _envelope.length():
		return 0.0
	return ("0x" + _envelope[i]).hex_to_int() / 15.0


func _on_finished() -> void:
	speaking = false
	current_speaker = ""
	_envelope = ""
	Music.voice_duck(false)
	line_finished.emit()
