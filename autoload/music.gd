extends Node
## Adaptive music. Each track is a set of loop-exact stems that share tempo and
## key (generated by tools/gen_music.py). All stems of a track start together
## and stay in sync; the game blends them:
##   play(track)          crossfade to a track
##   set_intensity(0..1)  explore -> combat (the "combat" stem rises)
##   set_layer(stem, on)  extra layers such as Tataka's "maya"
##   duck(on)             dip under dialogue
## Sound effects are routed to the SFX bus automatically.

const DIR := "res://assets/audio/music/"
## track -> stems; the first stem is the base layer that always plays.
const TRACKS := {
	"menu": ["main"],
	"ayodhya": ["explore", "combat"],
	"forest": ["explore", "combat"],
	"tataka": ["boss", "maya"],
	"bloom": ["main"],
}
const SILENT_DB := -60.0
const CROSSFADE := 1.5
const BLEND := 1.0
const DUCK_DB := -8.0
## At full intensity the explore layer steps back a little under the combat one.
const EXPLORE_AT_COMBAT_DB := -4.0

var current := ""
var intensity := 0.0
var ducked := false

var _players := {}   # stem -> AudioStreamPlayer (current track)
var _layers := {}    # stem -> bool (optional layers that are on)
var _tweens := {}    # stem -> Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS  # keeps playing (quietly) while paused
	Settings.ensure_audio_buses()
	get_tree().node_added.connect(_route_sfx)


## Crossfades to `track` (no-op if it is already playing).
func play(track: String) -> void:
	if track == current or not TRACKS.has(track):
		return
	_fade_out_all()
	current = track
	intensity = 0.0
	_layers.clear()
	for stem: String in TRACKS[track]:
		var stream := load(DIR + "%s_%s.ogg" % [track, stem]) as AudioStream
		if stream == null:
			push_warning("Music stem missing: %s_%s" % [track, stem])
			continue
		if stream is AudioStreamOggVorbis:
			(stream as AudioStreamOggVorbis).loop = true
		var p := AudioStreamPlayer.new()
		p.name = "%s_%s" % [track, stem]
		p.stream = stream
		p.bus = &"Music"
		p.volume_db = SILENT_DB
		p.process_mode = Node.PROCESS_MODE_ALWAYS
		add_child(p)
		_players[stem] = p
	for stem: String in _players:  # start together so the stems stay in sync
		(_players[stem] as AudioStreamPlayer).play()
	_retarget(CROSSFADE)


func stop() -> void:
	_fade_out_all()
	current = ""


## 0 = exploring, 1 = full combat.
func set_intensity(value: float) -> void:
	value = clampf(value, 0.0, 1.0)
	if is_equal_approx(value, intensity):
		return
	intensity = value
	_retarget(BLEND)


func set_layer(stem: String, on: bool) -> void:
	if _layers.get(stem, false) == on:
		return
	_layers[stem] = on
	_retarget(BLEND * 2.0)


func duck(on: bool) -> void:
	if ducked == on:
		return
	ducked = on
	_retarget(0.6)


## The volume a stem should sit at right now.
func target_db(stem: String) -> float:
	if not TRACKS.has(current):
		return SILENT_DB
	var stems: Array = TRACKS[current]
	var db := 0.0
	if stem == stems[0]:
		db = EXPLORE_AT_COMBAT_DB * intensity if stem == "explore" else 0.0
	elif stem == "combat":
		db = linear_to_db(maxf(intensity, 0.001))
	else:
		db = 0.0 if _layers.get(stem, false) else SILENT_DB
	if ducked:
		db += DUCK_DB
	return maxf(db, SILENT_DB)


func player(stem: String) -> AudioStreamPlayer:
	return _players.get(stem)


func _retarget(seconds: float) -> void:
	for stem: String in _players:
		var p := _players[stem] as AudioStreamPlayer
		if _tweens.has(stem) and (_tweens[stem] as Tween).is_valid():
			(_tweens[stem] as Tween).kill()
		var t: Tween = create_tween()
		t.tween_property(p, "volume_db", target_db(stem), seconds)
		_tweens[stem] = t


func _fade_out_all() -> void:
	for stem: String in _players:
		var p := _players[stem] as AudioStreamPlayer
		p.name = "fading_" + p.name
		var t: Tween = create_tween()
		t.tween_property(p, "volume_db", SILENT_DB, CROSSFADE)
		t.tween_callback(p.queue_free)
	_players.clear()
	_tweens.clear()


## Every other player (bow, impacts, voices...) goes to the SFX bus.
func _route_sfx(node: Node) -> void:
	if node.get_parent() == self:
		return
	if node is AudioStreamPlayer and (node as AudioStreamPlayer).bus == &"Master":
		(node as AudioStreamPlayer).bus = &"SFX"
	elif node is AudioStreamPlayer3D and (node as AudioStreamPlayer3D).bus == &"Master":
		(node as AudioStreamPlayer3D).bus = &"SFX"
	elif node is AudioStreamPlayer2D and (node as AudioStreamPlayer2D).bus == &"Master":
		(node as AudioStreamPlayer2D).bus = &"SFX"
